/* === CONFIRM DIALOG (MODAL) === */
.confirm-dialog {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.confirm-dialog-box {
    width: 500px;
    background-color: rgb(20, 20, 30);
    border-width: 2px;
    border-color: rgb(150, 150, 200);
    border-radius: 8px;
    padding: 40px;
    align-items: center;
}

.confirm-title {
    font-size: 32px;
    color: rgb(255, 100, 100);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.confirm-message {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin-bottom: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.confirm-buttons {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.confirm-button {
    width: 45%;
    height: 50px;
    font-size: 20px;
    border-radius: 4px;
    border-width: 2px;
    transition-duration: 0.2s;
}

.confirm-yes {
    background-color: rgba(200, 50, 50, 0.3);
    border-color: rgb(200, 50, 50);
    color: rgb(255, 150, 150);
}

.confirm-yes:hover,
.confirm-yes:focus {
    background-color: rgba(200, 50, 50, 0.6);
    color: rgb(255, 255, 255);
}

.confirm-no {
    background-color: rgba(100, 100, 150, 0.3);
    border-color: rgb(100, 100, 150);
    color: rgb(200, 200, 220);
}

.confirm-no:hover,
.confirm-no:focus {
    background-color: rgba(100, 100, 150, 0.6);
    color: rgb(255, 255, 255);
}
